{
  "name": "@boy-offi9-inc/Playfold",
  "version": "0.1.0",
  "description": "Tiny, framework-agnostic SDK for embedding media players in an iframe and controlling them through a typed, promise-based API.",
  "keywords": [
    "embed",
    "iframe",
    "player",
    "audio",
    "video",
    "postmessage",
    "oembed",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/playfold.global.js",
  "jsdelivr": "./dist/playfold.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./host": {
      "import": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.js"
      },
      "require": {
        "types": "./dist/host.d.cts",
        "default": "./dist/host.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./browser": "./dist/playfold.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boy-offi9-inc/playfold.git"
  },
  "homepage": "https://github.com/boy-offi9-inc/playfold#readme",
  "bugs": {
    "url": "https://github.com/boy-offi9-inc/playfold/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "playwright": "^1.48.0",
    "react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
